rules_version = '2';

// Trancado por padrão até desenharmos as regras de verdade (ver README.md
// desta pasta). Ninguém lê nem escreve nada até isso ser decidido.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
